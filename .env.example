# Copy to .env.local (local) or set in Vercel > Project > Settings > Environment Variables.
# NEVER commit real values.

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME

# --- Auth.js ---
# long random string: openssl rand -base64 32
AUTH_SECRET=
# public address of THIS deployment, no trailing slash (Google redirects back here)
AUTH_URL=http://localhost:3000

# --- Google sign-in for guests (Google Cloud Console > APIs & Services > Credentials) ---
# Authorised redirect URI to register:  <AUTH_URL>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- Cron (Vercel Cron sends this as "Authorization: Bearer <value>"); at least 16 characters ---
CRON_SECRET=

# --- Email (Resend) ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=
HOTEL_NOTIFICATION_EMAIL=

# --- Client IP for rate limiting ---
# Leave empty on Vercel (it is detected automatically). Behind your own proxy, set the NAME of the
# header that ONLY your proxy sets, e.g. x-forwarded-for. Never set it on a server reachable directly.
TRUSTED_PROXY_HEADER=

NEXT_PUBLIC_SITE_URL=http://localhost:3000
